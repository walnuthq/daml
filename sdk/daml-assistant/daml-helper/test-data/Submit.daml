-- | Template used by `test-daml-ledger` to exercise `daml ledger submit`.
module Submit where

template Counter
  with
    owner : Party
    count : Int
  where
    signatory owner

    choice Bump : ContractId Counter
      with
        by : Int
      controller owner
      do
        create this with count = count + by

    choice Reset : ContractId Counter
      controller owner
      do
        create this with count = 0
